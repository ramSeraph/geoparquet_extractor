+    public async resetOPFSTempDir(): Promise<void> {
+        const runtime = this._runtime as any;
+        const pool = runtime._opfsTmpPool;
+        if (!pool) return;
+        for (const name of [...pool.open.keys()]) this.dropFile(name);
