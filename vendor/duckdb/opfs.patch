+    public async registerOPFSTempDir(path?: string, maxUnused?: number, minUnused?: number): Promise<void> {
+        const runtime = this._runtime as any;
+        const pool = runtime._opfsTmpPool;
+        if (path) path = canonicalTempPath(path);
+        if (pool && path === pool.path &&
+            (maxUnused === undefined || maxUnused === pool.maxUnused) &&
+            (minUnused === undefined || minUnused === pool.minUnused)) return;
+        if (pool?.open.size) {
+            throw new Error('Reset DuckDB before replacing an OPFS temp pool that has open files');
+        }
+        const replacement = path ? await OPFSTempPool.create(path, maxUnused, minUnused) : null;
+        await this.resetOPFSTempDir();
+        runtime._opfsTmpPool = replacement;
+    }
